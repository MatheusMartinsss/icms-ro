# Site público, sem banco: transportadoras e histórico ficam no navegador.

# CNPJá (mesma conta do gflona). Sem isso a busca usa só a BrasilAPI,
# que não traz a inscrição estadual.
CNPJA_API_KEY=
CNPJA_BASE_URL=https://api.cnpja.com

# gdare (emissor de DARE/DAR). Em produção o compose define http://gdare:8080 (rede interna).
GDARE_URL=http://127.0.0.1:8080
# A mesma API_KEY configurada no .env do gdare.
GDARE_API_KEY=

# Google Distance Matrix (botão Buscar Distância). Lido só no servidor.
GOOGLE_API_KEY=
GOOGLE_API_URL=https://maps.googleapis.com/maps/api/distancematrix/json
